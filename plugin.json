{
  "id": "legado-booksource",
  "name": "Legado 书源引擎",
  "version": "0.4.4",
  "apiVersion": 1,
  "runtime": "node",
  "entry": "src/index.js",
  "permissions": {
    "storage": true,
    "network": true
  },
  "extensions": {
    "pages": [
      {
        "id": "manage",
        "title": "Legado 书源管理"
      }
    ],
    "tasks": [
      {
        "id": "auto-check",
        "intervalMinutes": 60
      }
    ]
  },
  "sourceTypes": [
    {
      "id": "legado",
      "label": "Legado JSON 书源",
      "capabilities": [
        "browse",
        "search",
        "content.alternatives",
        "detail",
        "acquire.chapters",
        "content.manifest",
        "content.resource",
        "content.update"
      ]
    }
  ]
}
